# ============================================================
# ServerConsole 三端协同系统 - 环境变量配置
# 复制本文件为 .env 并修改你的配置
# ============================================================

# 控制台面板密钥（必填，用于 App 登录/API 认证，请改成一个足够随机的值）
AGENT_KEY=change_me_to_a_random_key

# QQ 机器人账号（NapCat 登录用，必填）
QQ_ACCOUNT=10001

# 服务器公网 IP（DSH 的 HTTPS 访问地址用，可选）
SERVER_IP=

# DeepSeek Harness（DSH）账号密码（可选，不需要可留空跳过该服务）
DSH_USER=admin
DSH_PASSWORD=

# ---- 面板品牌（可选，去品牌化默认「控制台」）----
# PANEL_NAME=控制台
# PANEL_LOGO=控
# PANEL_SUB=服务器控制台
